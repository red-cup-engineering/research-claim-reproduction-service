              },
              "denominator": {
                "pointer": {
                  "record": "survey",
                  "path": "/respondents"
                }
              },
              "places": 2
            }
          },
          "basis": "group a / respondents"
        },
        {
          "id": "share-group-b",
          "manuscript": "03-results",
          "stated": "60.1",
          "expression": {
            "percent": {
              "numerator": {
                "get": {
                  "from": {
                    "ref": "groups"
                  },
                  "key": 1
                }
              },
              "denominator": {
                "pointer": {
                  "record": "survey",
                  "path": "/respondents"
                }
              },
              "places": 2
            }
          },
          "basis": "group b / respondents"
