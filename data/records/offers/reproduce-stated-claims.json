  "bodySchema": {
    "type": "object",
    "required": [
      "spec"
    ],
    "additionalProperties": false,
    "properties": {
      "records": {
        "type": "object",
        "description": "Record name (as named in spec.records) to the record's parsed JSON value. Numbers arrive as doubles, so integers beyond 2^53 and decimals with more than 17 significant digits are not exact; use recordTexts for those."
      },
      "recordTexts": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "Record name to the record's JSON text; every number literal is read exactly. A record is given in records or in recordTexts, not both."
      },
      "spec": {
        "type": "object",
        "description": "The claim-spec: records, bindings, claims and (for projection) tables and documents. See schemas/claim-spec.schema.json."
